# ==========================================================
# PRODUCTION ENVIRONMENT CONFIGURATION
# ==========================================================

# Deployment Controls (Set AUTO_DEPLOY=false to prevent accidental prod deployments)
AUTO_DEPLOY=false
DEPLOY_TYPE=prod

# Server & Remote Path Configuration
VM_USER=root
VM_IP=200.97.175.94
REMOTE_DIR=/opt/bleep/bleep-learnhub/production/backend

# Docker Image & Container Settings
IMAGE_NAME=bleep-learnhub-backend-prod
IMAGE_TAG=latest
CONTAINER_NAME=bleep-learnhub-backend-prod
HOST_PORT=8080
CONTAINER_PORT=8080

# General App Config
SPRING_APPLICATION_NAME=bleep-learnhub-backend
SERVER_SERVLET_CONTEXT_PATH=/bleep-learnhub-backend/api/v1
APP_LOGGING_VERBOSE=false

# PostgreSQL Database Config
SPRING_DATASOURCE_URL=jdbc:postgresql://host.docker.internal:5432/learnhub_db_prod
SPRING_DATASOURCE_USERNAME=bleepuser_prod
SPRING_DATASOURCE_PASSWORD=bleepLearnhub8795346_prod
SPRING_JPA_HIBERNATE_DDL_AUTO=validate
SPRING_JPA_SHOW_SQL=false

# Redis Config
SPRING_DATA_REDIS_HOST=host.docker.internal
SPRING_DATA_REDIS_PORT=6380
SPRING_DATA_REDIS_PASSWORD=bleepLearnhub8795346
SPRING_DATA_REDIS_DATABASE=0

# Mail SMTP Config
SPRING_MAIL_HOST=smtp.hostinger.com
SPRING_MAIL_PORT=465
SPRING_MAIL_USERNAME=care@trainingcentral.in
SPRING_MAIL_PASSWORD=Asit12@@
SPRING_MAIL_PROPERTIES_MAIL_SMTP_AUTH=true
SPRING_MAIL_PROPERTIES_MAIL_SMTP_SSL_ENABLE=true
SPRING_MAIL_PROPERTIES_MAIL_TRANSPORT_PROTOCOL=smtp
SPRING_MAIL_PROPERTIES_MAIL_DEBUG=false

# Security & JWT
APPLICATION_SECURITY_JWT_SECRET_KEY=U2VjdXJlS2V5Rm9yQmxjZXBMZWFybkh1YkJhY2tlbmRXaXRoU3VmZmljaWVudExlbmd0aE9mQnl0ZXM=
APPLICATION_SECURITY_JWT_EXPIRATION=86400000

# Rate Limits
APP_API_RATE_LIMIT_MAX_REQUESTS=200
APP_API_RATE_LIMIT_TIME_FRAME_MINUTES=1
APP_OTP_MAX_REQUESTS=5
APP_OTP_TIME_FRAME_MINUTES=30

# Admin Seeder
